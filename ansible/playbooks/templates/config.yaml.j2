# ByteFreezer Control Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ inventory_hostname }}

app:
  name: {{ config.app.name }}
  version: {{ config.app.version }}

# Logging configuration
logging:
  level: {{ config.logging.level }}
  encoding: {{ config.logging.encoding }}

# API server configuration
server:
  api_port: {{ config.server.api_port }}

# Database configuration for tenant management
database:
  enabled: {{ config.database.enabled | lower }}
  type: "{{ config.database.type }}"
  host: "{{ config.database.host }}"
  port: {{ config.database.port }}
  database: "{{ config.database.database }}"
  username: "{{ config.database.username }}"
  password: "{{ config.database.password }}"
  ssl_mode: "{{ config.database.ssl_mode }}"
  max_connections: {{ config.database.max_connections }}
  max_idle_connections: {{ config.database.max_idle_connections }}

# OpenTelemetry configuration
otel:
  enabled: {{ config.otel.enabled | lower }}
  service_name: "{{ config.otel.service_name }}"
  scrape_interval_seconds: {{ config.otel.scrape_interval_seconds }}
  metrics_host: "{{ config.otel.metrics_host }}"
  metrics_port: {{ config.otel.metrics_port }}

# Housekeeping configuration
housekeeping:
  enabled: {{ config.housekeeping.enabled | lower }}
  interval_seconds: {{ config.housekeeping.interval_seconds }}

# Authentication and authorization
auth:
  enabled: {{ config.auth.enabled | lower }}
  jwt_secret: "{{ config.auth.jwt_secret }}"
  token_expiry_hours: {{ config.auth.token_expiry_hours }}
  admin_users:
{% for user in config.auth.admin_users %}
    - "{{ user }}"
{% endfor %}

# Rate limiting
rate_limit:
  enabled: {{ config.rate_limit.enabled | lower }}
  requests_per_minute: {{ config.rate_limit.requests_per_minute }}
  burst_size: {{ config.rate_limit.burst_size }}

# Health reporting configuration
health_reporting:
  enabled: {{ config.health_reporting.enabled | default(true) | lower }}
  control_url: "{{ config.health_reporting.control_url | default('http://localhost:8082') }}"
  report_interval: "{{ config.health_reporting.report_interval | default('30s') }}"
  timeout_seconds: {{ config.health_reporting.timeout_seconds | default(10) }}
  register_on_startup: {{ config.health_reporting.register_on_startup | default(true) | lower }}

# Development mode
dev: {{ config.dev | lower }}